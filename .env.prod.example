# ============================================================
# .env.prod — NutriTrack Production
# ============================================================
# Copier ce fichier vers .env.prod et remplir les valeurs:
#   cp .env.prod.example .env.prod
# ============================================================

# Port du serveur (ne pas changer — exposé en 3001 dans docker-compose)
PORT=3001

# Environnement
NODE_ENV=production

# Chemins ABSOLUS dans le container (WORKDIR=/app/server)
DB_PATH=/app/sqlite/nutrition.db
CLIENT_DIST_PATH=/app/client/dist

# Secret admin — OBLIGATOIRE en production
# Générer avec: openssl rand -hex 32
ADMIN_SECRET=CHANGER_CE_SECRET_OBLIGATOIRE

# Origine CORS — domaine ou IP publique du serveur
# Exemples:
#   CORS_ORIGIN=https://nutrition.mondomaine.com
#   CORS_ORIGIN=https://1.2.3.4
#   CORS_ORIGIN=https://example.com
# Pour accès sans domaine (IP directe):
CORS_ORIGIN=*
